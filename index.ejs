<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="LiM-iMa is a quiet corner for everyday thoughts, stories, and things worth remembering." />
    <title>LiM-iMa — Home</title>
    <link rel="stylesheet" href="./styles.css" />
    <script src="./app.js" defer></script>
  </head>
  <body>
    <div class="page-shell">
      <header class="topbar">
        <a class="brand-wrap" href="./" aria-label="LiM-iMa home">
          <span class="brand-mark" aria-hidden="true">L</span>
          <span class="brand-copy">
            <span class="eyebrow">A personal journal</span>
            <span class="brand-name">LiM-iMa</span>
          </span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          <a href="./">Home</a>
          <a href="./profile.html">Profile</a>
          <a href="./about.html">About</a>
        </nav>
        <button id="themeToggle" class="theme-toggle" type="button" aria-pressed="false">Dark mode</button>
      </header>

      <main>
        <section class="hero">
          <div class="hero-copy">
            <p class="eyebrow">Words, moments, and everything in between</p>
            <h1>A little space<br />to <em>think out loud.</em></h1>
            <p class="hero-description">A shared space for the ideas that arrive unexpectedly and the moments you want to keep. Anyone can post and join the conversation.</p>
            <a class="text-link" href="#latest">Read the latest <span aria-hidden="true">↘</span></a>
          </div>
          <div class="hero-art" aria-label="Abstract illustration of a sun setting over hills" role="img">
            <span class="sun"></span>
            <span class="hill hill-back"></span>
            <span class="hill hill-front"></span>
            <span class="art-caption">a slower kind of scroll</span>
          </div>
        </section>

        <section class="dictionary-section" aria-labelledby="dictionary-heading">
          <div class="dictionary-intro">
            <p class="eyebrow">A word to keep</p>
            <h2 id="dictionary-heading">Look it up.</h2>
            <p>Find a definition, pronunciation, and examples with the Free Dictionary API.</p>
          </div>
          <div class="dictionary-content">
            <form id="dictionaryForm" class="dictionary-form">
              <label for="dictionaryWord">Search for a word</label>
              <div class="dictionary-search">
                <input id="dictionaryWord" name="word" type="search" maxlength="80" required placeholder="Search for a word..." autocomplete="off" />
                <button class="submit-button" type="submit">Search</button>
              </div>
            </form>
            <p id="dictionaryStatus" class="dictionary-status" role="status" aria-live="polite"></p>
            <div id="dictionaryResults" class="dictionary-results" aria-live="polite"></div>
            <p class="dictionary-credit">Definitions provided by <a href="https://github.com/meetDeveloper/freeDictionaryAPI" target="_blank" rel="noopener noreferrer">Free Dictionary API</a>.</p>
          </div>
        </section>

        <section id="latest" class="latest-section">
          <section class="post-composer" aria-labelledby="share-heading">
            <div>
              <p class="eyebrow">Your turn</p>
              <h2 id="share-heading">Share a thought</h2>
              <p>Post anything on your mind. No account needed.</p>
            </div>
            <form id="postForm">
              <label>
                <span>Your name <span class="optional-label">(optional)</span></span>
                <input name="authorName" maxlength="40" autocomplete="name" placeholder="Guest" />
              </label>
              <label>
                <span>Your post</span>
                <textarea name="content" rows="4" required placeholder="What would you like to share?"></textarea>
              </label>
              <div class="form-actions">
                <p class="form-status" aria-live="polite"></p>
                <button class="submit-button" type="submit">Publish post</button>
              </div>
            </form>
          </section>
          <div class="section-heading">
            <div>
              <p class="eyebrow">Fresh from the journal</p>
              <h2>Recent thoughts</h2>
            </div>
            <a class="text-link" href="./about.html">A little about this place <span aria-hidden="true">→</span></a>
          </div>
          <div id="postsList" class="posts-list" aria-live="polite">
            <p class="feed-message">Loading the latest thoughts…</p>
          </div>
        </section>

        <section class="profile-teaser">
          <div class="teaser-mark" aria-hidden="true">L</div>
          <div>
            <p class="eyebrow">Behind the words</p>
            <h2>A journal with a person behind it.</h2>
            <p>Get to know the voice and the little corner of the internet behind LiM-iMa.</p>
          </div>
          <a class="round-link" href="./profile.html" aria-label="Visit the profile">↗</a>
        </section>
      </main>

      <footer class="site-footer">
        <a class="footer-brand" href="./">LiM-iMa</a>
        <span>Made for the thoughts worth keeping.</span>
        <a href="./about.html">About this journal</a>
      </footer>
    </div>
  </body>
</html>
